# Postgres connection string, e.g. postgresql://user:password@localhost/bitsocial_github_alerts
DATABASE_URL=
# Public base URL where GitHub can reach this server
WEBHOOK_BASE_URL=https://github.bitsocial.net
# HTTP port the server listens on (default 8080)
PORT=8080
# Telegram bot token from @BotFather (required)
GITHUB_TELOXIDE_TOKEN=
# Random webhook signing secret, at least 32 bytes; set the same value on every GitHub hook.
GITHUB_WEBHOOK_SECRET=
# Core maintainers: their issues and pull requests are only counted in the digest
CORE_GITHUB_LOGINS=tomcasaburi,Rinse12
# Hours between digests from 18:00 UTC: a divisor of 24 (default 24), or 0 to turn the digest off
DIGEST_INTERVAL_HOURS=24
# Admin logging to a Telegram chat: ACTIVE or NOT_ACTIVE
ADMIN_LOGS=NOT_ACTIVE
# 0-255, higher = more verbose admin logs
ADMIN_LOG_LEVEL=50
# Telegram chat id that receives admin logs
TELEGRAM_ADMIN_CHAT_ID=
